class_name ClipFiles
extends RefCounted
## Hand-editable animation clips for one character. The clips MIRA plays are generated by code (CharacterFallbackAnimationBuilder); CharacterAnimationController already lets a saved clip of the same name
## replace a generated one (`clip_library`). Edits go to a DRAFT library, `<tuning folder>/drafts/clips.tres`, which only the Workbench plays; "Apply to game" copies one clip into `<tuning folder>/clips.tres`,
## which CharacterRig loads for the game. Beside the draft, `drafts/clip_editor.tscn`: the character's model with an AnimationPlayer on its skeleton, so Godot's own Animation panel and skeleton posing edit the
## draft clip on her body.
## Only the base clip is edited there: the pose stages (IK, crouch, ladder, weapon) still apply on top in the Workbench and the game.

const LIBRARY_FILE := "clips.tres"
const SCENE_FILE := "clip_editor.tscn"
const PLAYER := "Clips"

## The game's library of edited clips.
static func game_path(rig: CharacterRig) -> String:
	var folder := rig.tuning_folder()
	return folder.path_join(LIBRARY_FILE) if folder != "" else ""

## The Workbench's draft library (what "Edit this clip in Godot" edits).
static func library_path(rig: CharacterRig) -> String:
	var folder := rig.tuning_folder()
	return folder.path_join(CharacterRig.DRAFTS).path_join(LIBRARY_FILE) if folder != "" else ""

static func scene_path(rig: CharacterRig) -> String:
	var folder := rig.tuning_folder()
	return folder.path_join(CharacterRig.DRAFTS).path_join(SCENE_FILE) if folder != "" else ""

## The library the Workbench plays: the draft when there is one, else the game's, fresh from disk (never a cached copy), or a new empty one.
static func load_library(rig: CharacterRig) -> AnimationLibrary:
	var draft := _read(library_path(rig))
	return draft if draft != null else load_game_library(rig)

static func load_game_library(rig: CharacterRig) -> AnimationLibrary:
	var game := _read(game_path(rig))
	return game if game != null else AnimationLibrary.new()

static func _read(path: String) -> AnimationLibrary:
	if path != "" and ResourceLoader.exists(path):
		var loaded := ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_IGNORE)
		if loaded is AnimationLibrary:
			return loaded
	return null

## Clips whose draft differs from the game (edited and not applied, or taken out and not applied).
static func changed_clips(rig: CharacterRig) -> Array[StringName]:
	var out: Array[StringName] = []
	if _read(library_path(rig)) == null:
		return out
	var draft := load_library(rig)
	var game := load_game_library(rig)
	var names := {}
	for name in draft.get_animation_list() + game.get_animation_list():
		names[name] = true
	for name in names:
		var a: Animation = draft.get_animation(name) if draft.has_animation(name) else null
		var b: Animation = game.get_animation(name) if game.has_animation(name) else null
		if not same_clip(a, b):
			out.append(StringName(name))
	out.sort()
	return out

## Two clips with the same length, loop, tracks and keys (null is "no edited clip").
static func same_clip(a: Animation, b: Animation) -> bool:
	if a == null or b == null:
		return a == b
	if not is_equal_approx(a.length, b.length) or a.loop_mode != b.loop_mode or a.get_track_count() != b.get_track_count():
		return false
	for t in a.get_track_count():
		if a.track_get_path(t) != b.track_get_path(t) or a.track_get_type(t) != b.track_get_type(t) or a.track_get_key_count(t) != b.track_get_key_count(t):
			return false
		for k in a.track_get_key_count(t):
			var va: Variant = a.track_get_key_value(t, k)
			var vb: Variant = b.track_get_key_value(t, k)
			var equal: bool = va.is_equal_approx(vb) if (va is Quaternion or va is Vector3) else va == vb
			if not is_equal_approx(a.track_get_key_time(t, k), b.track_get_key_time(t, k)) or not equal:
				return false
	return true

## Copies the draft of `clip` into the game's library (or takes it out of the game when the draft has none). Returns the path written, or "".
static func apply_clip(rig: CharacterRig, clip: StringName) -> String:
	var path := game_path(rig)
	if path == "":
		return ""
	var draft := load_library(rig)
	var game := load_game_library(rig)
	if game.has_animation(clip):
		game.remove_animation(clip)
	if draft.has_animation(clip):
		game.add_animation(clip, draft.get_animation(clip).duplicate(true))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(path.get_base_dir()))
	return path if ResourceSaver.save(game, path) == OK else ""

## Puts the game's version of `clip` back into the draft (or takes it out of the draft when the game has none).
static func discard_clip(rig: CharacterRig, clip: StringName) -> bool:
	var path := library_path(rig)
	if path == "" or _read(path) == null:
		return false
	var draft := load_library(rig)
	var game := load_game_library(rig)
	if draft.has_animation(clip):
		draft.remove_animation(clip)
	if game.has_animation(clip):
		draft.add_animation(clip, game.get_animation(clip).duplicate(true))
	return ResourceSaver.save(draft, path) == OK

## The clips this character plays (generated or saved), in a stable order, without the internal RESET.
static func clip_names(rig: CharacterRig) -> Array[StringName]:
	var out: Array[StringName] = []
	var player := _player(rig)
	if player == null:
		return out
	for name in player.get_animation_list():
		if name != &"RESET":
			out.append(StringName(name))
	out.sort()
	return out

## Whether `clip` comes from the saved (hand-edited) library rather than code.
static func is_edited(rig: CharacterRig, clip: StringName) -> bool:
	return load_library(rig).has_animation(clip)

## Copies the clip MIRA plays now into the saved library (when it is not there yet) and writes the editing scene. Returns {ok, message, library, scene}.
static func prepare(rig: CharacterRig, clip: StringName) -> Dictionary:
	var library_file := library_path(rig)
	if library_file == "":
		return {"ok": false, "message": "This character has no folder to keep edited clips in."}
	var player := _player(rig)
	if player == null or not player.has_animation(clip):
		return {"ok": false, "message": "There is no clip called %s." % clip}
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(library_file.get_base_dir()))
	var library := load_library(rig)
	var added := false
	if not library.has_animation(clip):
		library.add_animation(clip, player.get_animation(clip).duplicate(true))
		added = true
	if added or _read(library_file) == null:   # the first draft starts as a copy of the game's edited clips
		var error := ResourceSaver.save(library, library_file)
		if error != OK:
			return {"ok": false, "message": "Could not save %s (%s)." % [library_file, error_string(error)]}
	var scene_result := _write_scene(rig, library_file)
	if not scene_result.ok:
		return scene_result
	return {"ok": true, "message": ("Copied %s into the drafts so it can be edited (the game does not change until you apply it)." % clip) if added else "%s is already in the drafts." % clip, "library": library_file, "scene": scene_path(rig)}

## Takes `clip` out of the draft library, so the generated one plays again in the Workbench after the next reload (and in the game once applied).
static func forget(rig: CharacterRig, clip: StringName) -> bool:
	var path := library_path(rig)
	var library := load_library(rig)
	if path == "" or not library.has_animation(clip):
		return false
	library.remove_animation(clip)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(path.get_base_dir()))
	return ResourceSaver.save(library, path) == OK

## Puts every saved clip into the live character's player now (the Workbench calls this when the file changed on disk). Returns the clips replaced; an invalid clip is skipped and named in `skipped`.
static func apply_saved(rig: CharacterRig) -> Dictionary:
	var player := _player(rig)
	var applied: Array[StringName] = []
	var skipped: Array[StringName] = []
	if player == null or not player.has_animation_library(&""):
		return {"applied": applied, "skipped": skipped}
	var live := player.get_animation_library(&"")
	var saved := load_library(rig)
	for name in saved.get_animation_list():
		var clip := saved.get_animation(name)
		if not live.has_animation(name) or not valid_clip(rig, clip):
			skipped.append(StringName(name))
			continue
		live.remove_animation(name)
		live.add_animation(name, clip)
		applied.append(StringName(name))
	return {"applied": applied, "skipped": skipped}

## The same rule the controller uses for a saved clip: bone position and rotation tracks of this skeleton only.
static func valid_clip(rig: CharacterRig, clip: Animation) -> bool:
	if clip == null or clip.get_track_count() == 0:
		return false
	for track in clip.get_track_count():
		var path := clip.track_get_path(track)
		if clip.track_get_type(track) not in [Animation.TYPE_POSITION_3D, Animation.TYPE_ROTATION_3D]:
			return false
		if path.get_concatenated_names() != "." or path.get_subname_count() != 1 or rig.skeleton.find_bone(path.get_subname(0)) < 0:
			return false
	return true

## Last time the saved library changed on disk (0 when there is none).
static func modified_time(rig: CharacterRig) -> int:
	var path := library_path(rig)
	return FileAccess.get_modified_time(path) if path != "" and FileAccess.file_exists(path) else 0

static func _player(rig: CharacterRig) -> AnimationPlayer:
	return rig.animation_controller.animation_player if is_instance_valid(rig.animation_controller) and is_instance_valid(rig.animation_controller.animation_player) else null

## The editing scene: the model (children editable, so its Skeleton3D can be selected and posed), an AnimationPlayer whose root is that skeleton (the clips' tracks are ".:<bone>"), a light.
static func _write_scene(rig: CharacterRig, library_file: String) -> Dictionary:
	var root := Node3D.new()
	root.name = "ClipEditor"
	var model := rig.character_scene.instantiate() as Node3D
	model.name = "Model"
	model.scale = Vector3.ONE * rig.character_scale
	root.add_child(model)
	model.owner = root
	root.set_editable_instance(model, true)
	var skeleton := model.find_child("Skeleton3D", true, false) as Skeleton3D
	if skeleton == null:
		root.free()
		return {"ok": false, "message": "The model has no Skeleton3D."}
	var player := AnimationPlayer.new()
	player.name = PLAYER
	root.add_child(player)
	player.owner = root
	var names: Array[String] = []
	var walk: Node = skeleton
	while walk != model:
		names.push_front(String(walk.name))
		walk = walk.get_parent()
	player.root_node = NodePath("../Model/" + "/".join(names))
	player.add_animation_library(&"", load(library_file))
	var light := DirectionalLight3D.new()
	light.name = "Light"
	light.rotation_degrees = Vector3(-45, 35, 0)
	root.add_child(light)
	light.owner = root
	var packed := PackedScene.new()
	var error := packed.pack(root)
	root.free()
	if error == OK:
		error = ResourceSaver.save(packed, scene_path(rig))
	if error != OK:
		return {"ok": false, "message": "Could not write the editing scene (%s)." % error_string(error)}
	return {"ok": true}
