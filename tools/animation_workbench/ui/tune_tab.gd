class_name TuneTab
extends VBoxContainer
## "Change how she moves", without changing the game by accident.
## * A change is an EXPERIMENT: it applies to the live character at once and to nothing else. "Keep as draft" stores it (tuning/drafts/, read only by the Workbench). "Back to game values" undoes it.
## * "Apply to game" is the one action that changes what the game plays. It shows the list of changes and needs a second click to confirm (TuningFiles.apply_to_game).
## * Settings come from the motion profiles' own @export ranges and units. A few BASIC ones per profile are shown; the rest are behind "Show advanced settings" (a search looks at all of them).
## * Animation clips (generated by code) can be copied into the drafts and edited by hand in the Godot editor (ClipFiles, EditorBridge); a save there plays here at once; "Apply this clip to the game"
##   copies it for the game.
## Nothing here changes code, the presenter or the rig's behaviour: it sets the same profile values the rig already reads.

const PROFILES: Array[Dictionary] = [
	{"property": &"cover_profile", "title": "Cover: crouch, lean and turn",
		"basic": ["protected_yaw_degrees", "peek_yaw_degrees", "high_cover_crouch_depth", "high_cover_aim_crouch_depth", "head_clearance", "crouch_speed"]},
	{"property": &"locomotion_profile", "title": "Walking and running",
		"basic": ["walk_until", "jog_at", "run_at", "walk.stride_length", "walk.pelvis_bob", "walk.forward_lean_degrees", "speed_rise", "accel_lean_max"]},
	{"property": &"traversal_profile", "title": "Ladders and climbing",
		"basic": ["climb_speed", "descend_speed", "climb_lean_degrees", "hips_height", "hang_bias", "mount_length", "dismount_length", "vault_max_height"]},
	{"property": &"stair_profile", "title": "Stairs",
		"basic": ["speed", "swing_lift", "stance_roll", "heel_lift", "pelvis_sway", "tread_margin", "settle_speed_low"]},
	{"property": &"handling", "title": "Holding the weapon",
		"basic": ["raise_seconds", "lower_seconds", "hand_pitch_degrees", "ready_blend", "shot_recover_seconds"]},
]
## Stair values the rig measures from the body when it is built: editing them would do nothing, so they are not offered.
const MEASURED: Array[StringName] = [&"leg_length", &"ankle_height", &"hip_joint_offset", &"foot_front", &"foot_back", &"foot_half_width"]
const MAX_DEPTH := 1   # nested settings one level down (the walk, jog and run gaits)

var bench: Node3D
var _picked := 0
var _choice: OptionButton
var _search: LineEdit
var _advanced: CheckBox
var _rows: VBoxContainer
var _status: Label
var _changes: Label
var _apply_button: Button
var _replay: Button
var _confirm := false
var _kept := {}       # profile index -> {path: value} when last kept as a draft (or loaded)
var _entries: Array[Dictionary] = []
var _resets := {}     # path -> its "back to game" button
var _titles := {}     # path -> its title label
var _file_time := {}  # profile index -> modified time of its draft when last read or written (a save in Godot shows up as a newer time)
var _clip_choice: OptionButton
var _clip_status: Label
var _clip_apply: Button
var _clip_confirm := false
var _clips_time := 0

func setup(workbench: Node3D) -> void:
	bench = workbench
	add_theme_constant_override("separation", 6)
	add_child(WorkbenchUI.label("Try changes here: they show at once and do NOT change the game. 'Keep as draft' keeps them; 'Apply to game' is the only button that changes what the game plays.", 14))

	var clips := WorkbenchUI.section(self, "Animation clips (edit by hand in Godot)")
	clips.add_child(WorkbenchUI.label("Her clips are made by code. 'Edit this clip in Godot' copies the clip into the drafts and opens it on her body in Godot's Animation panel. Save there (Ctrl+S): it plays here at once.", 13, WorkbenchUI.DIM))
	_clip_choice = OptionButton.new()
	_clip_choice.item_selected.connect(func(_i: int) -> void: _clip_confirm = false; _sync_clip_buttons())
	clips.add_child(_clip_choice)
	_clip_apply = WorkbenchUI.button("Apply this clip to the game", func() -> void: apply_clip_to_game(), "Copies your edited clip to where the game reads it (asks you to confirm)")
	var clip_row := HBoxContainer.new()
	for node: Button in [WorkbenchUI.button("Edit this clip in Godot", edit_clip, "Copies the clip into the drafts (if it is not there yet) and opens it in the Godot editor"), _clip_apply]:
		node.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		clip_row.add_child(node)
	clips.add_child(clip_row)
	clips.add_child(WorkbenchUI.row([["Back to the game's clip", discard_clip, "Throws away your draft of this clip"], ["Use the generated clip", _forget_clip, "Takes this clip out of the drafts: the code-made one plays after a reload (and in the game once applied)"]]))
	_clip_status = WorkbenchUI.label("", 13, WorkbenchUI.ACCENT)
	clips.add_child(_clip_status)
	_fill_clips()
	_clips_time = ClipFiles.modified_time(bench.rig)

	var settings := WorkbenchUI.section(self, "Settings")
	_choice = OptionButton.new()
	for profile in PROFILES:
		_choice.add_item(profile.title)
	_choice.item_selected.connect(func(index: int) -> void:
		_picked = index
		_confirm = false
		_build())
	settings.add_child(_choice)
	_search = LineEdit.new()
	_search.placeholder_text = "Find a setting (for example: crouch)"
	_search.text_changed.connect(func(_text: String) -> void: _filter())
	settings.add_child(_search)
	_advanced = WorkbenchUI.check("Show advanced settings", false, func(_on: bool) -> void: _filter(), "The technical parameters. The basic ones are the ones worth trying first")
	settings.add_child(_advanced)
	var keep := HBoxContainer.new()
	for node: Button in [WorkbenchUI.button("Keep as draft", func() -> void: save_draft(), "Keeps these values for the Workbench only (the game does not change)"), WorkbenchUI.button("Back to game values", discard, "Undoes every change on this page and throws the draft away")]:
		node.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		keep.add_child(node)
	settings.add_child(keep)
	_apply_button = WorkbenchUI.button("Apply to game...", func() -> void: apply_to_game(), "Shows the changes, then a second click writes them where the game reads them")
	var game := HBoxContainer.new()
	for node: Button in [_apply_button, WorkbenchUI.button("Edit in Godot", edit_in_godot, "Opens this draft in the Godot editor's Inspector; what you save there shows up here")]:
		node.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		game.add_child(node)
	settings.add_child(game)
	_replay = WorkbenchUI.button("Play the scenario again", _play_again, "Restarts the scenario that ran last, so you see the change from the start")
	settings.add_child(_replay)
	_status = WorkbenchUI.label("", 13, WorkbenchUI.ACCENT)
	settings.add_child(_status)
	_changes = WorkbenchUI.label("", 13, WorkbenchUI.WARN)
	settings.add_child(_changes)
	_rows = VBoxContainer.new()
	_rows.add_theme_constant_override("separation", 2)
	settings.add_child(_rows)
	_build()

# ---- what is edited

## The profile being edited. For stairs it is the authored one (the rig copies it and adds this body's measurements; see CharacterRig.reapply_stair_profile).
func profile() -> Resource:
	var property: StringName = PROFILES[_picked].property
	if property == &"stair_profile" and bench.rig.stair_profile_source != null:
		return bench.rig.stair_profile_source
	return bench.rig.get(property)

func property() -> StringName:
	return PROFILES[_picked].property

## Picks a profile by its rig property name (tests and the Start tab).
func pick(name: StringName) -> void:
	for index in PROFILES.size():
		if PROFILES[index].property == name:
			_picked = index
			_choice.select(index)
			_confirm = false
			_build()

## Every editable number, switch and vector of `resource`, in declaration order with its group: {owner, name, path, type, hint, hint_string, group}.
static func entries_of(resource: Resource, prefix := "", group := "", depth := 0) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	if resource == null:
		return out
	var current := group
	for info: Dictionary in resource.get_property_list():
		var usage := int(info.usage)
		if usage & PROPERTY_USAGE_GROUP:
			current = String(info.name) if String(info.name) != "" else group
			continue
		if usage & PROPERTY_USAGE_SUBGROUP or not (usage & PROPERTY_USAGE_SCRIPT_VARIABLE) or not (usage & PROPERTY_USAGE_EDITOR):
			continue
		var name := StringName(info.name)
		if MEASURED.has(name) and resource is StairProfile:
			continue
		var type := int(info.type)
		if type in [TYPE_FLOAT, TYPE_INT, TYPE_BOOL, TYPE_VECTOR3]:
			out.append({"owner": resource, "name": name, "path": prefix + String(name), "type": type, "hint": int(info.hint), "hint_string": String(info.hint_string), "group": current})
		elif type == TYPE_OBJECT and depth < MAX_DEPTH and resource.get(name) is Resource:
			out.append_array(entries_of(resource.get(name), prefix + String(name) + ".", humanize(String(name)), depth + 1))
	return out

## Whether a setting is one of the profile's basic ones.
func is_basic(entry: Dictionary) -> bool:
	return (PROFILES[_picked].basic as Array).has(String(entry.path))

## "high_cover_crouch_depth" -> "High cover crouch depth".
static func humanize(name: String) -> String:
	var words := name.replace("_", " ").strip_edges()
	return words.substr(0, 1).to_upper() + words.substr(1) if words != "" else name

## A row's title with its unit once: "protected_yaw_degrees" with "°" -> "Protected yaw (°)", "raise_seconds" with "s" -> "Raise (s)".
static func label_of(name: String, suffix: String) -> String:
	var words := humanize(name)
	for unit_word in [" degrees per second", " per second", " degrees", " seconds", " metres", " meters"]:
		if suffix != "" and words.to_lower().ends_with(unit_word):
			words = words.substr(0, words.length() - unit_word.length())
			break
	return words + ((" (%s)" % suffix) if suffix != "" else "")

## The range hint of a property: {min, max, step, suffix, greater, lesser, ok}.
static func range_of(entry: Dictionary) -> Dictionary:
	var result := {"min": 0.0, "max": 0.0, "step": 0.001 if int(entry.type) == TYPE_FLOAT else 1.0, "suffix": "", "greater": true, "lesser": true, "ok": false}
	var parts := String(entry.hint_string).split(",")
	if int(entry.hint) == PROPERTY_HINT_RANGE and parts.size() >= 2:
		result.min = float(parts[0])
		result.max = float(parts[1])
		result.step = float(parts[2]) if parts.size() > 2 and String(parts[2]).is_valid_float() else result.step
		result.greater = false
		result.lesser = false
		result.ok = true
		for extra in parts.slice(2):
			var flag := String(extra).strip_edges()
			if flag.begins_with("suffix:"):
				result.suffix = flag.trim_prefix("suffix:")
			elif flag == "or_greater":
				result.greater = true
			elif flag == "or_less":
				result.lesser = true
	return result

## The value at a dotted path ("walk.stride_length") of a resource, or null.
static func value_at(resource: Resource, path: String) -> Variant:
	var at: Variant = resource
	for part in path.split("."):
		if not (at is Object):
			return null
		at = (at as Object).get(part)
	return at

# ---- the rows

func _snapshot() -> Dictionary:
	var values := {}
	for entry in entries_of(profile()):
		values[entry.path] = entry.owner.get(entry.name)
	return values

func _build() -> void:
	for child in _rows.get_children():
		child.queue_free()
	_resets.clear()
	_titles.clear()
	if not _kept.has(_picked):
		_kept[_picked] = _snapshot()
	_entries = entries_of(profile())
	if _entries.is_empty():
		_rows.add_child(WorkbenchUI.label("This character has nothing to tune here.", 13, WorkbenchUI.DIM))
	var group := "<no group yet>"
	for entry in _entries:
		if String(entry.group) != group:
			group = String(entry.group)
			if group != "":
				var heading := WorkbenchUI.label(group, 14, WorkbenchUI.ACCENT)
				heading.set_meta("group", group)
				_rows.add_child(heading)
		_rows.add_child(_row(entry))
	var advanced := 0
	for entry in _entries:
		if not is_basic(entry):
			advanced += 1
	_advanced.text = "Show advanced settings (%d more)" % advanced
	_filter()
	_update_status()

func _row(entry: Dictionary) -> Control:
	var box := VBoxContainer.new()
	box.set_meta("text", (String(entry.group) + " " + String(entry.path)).to_lower().replace("_", " "))
	box.set_meta("basic", is_basic(entry))
	box.add_theme_constant_override("separation", 0)
	var limits := range_of(entry)
	var title := label_of(String(entry.name), String(limits.suffix))
	var line := HBoxContainer.new()
	var reset := WorkbenchUI.button("game", func() -> void: _apply(entry, game_value(entry), true), "Back to the value the game uses")
	_resets[entry.path] = reset
	var value: Variant = entry.owner.get(entry.name)
	match int(entry.type):
		TYPE_BOOL:
			var check := WorkbenchUI.check(title, bool(value), func(on: bool) -> void: _apply(entry, on))
			check.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			line.add_child(check)
		TYPE_INT when int(entry.hint) == PROPERTY_HINT_ENUM:
			_title(box, entry, title)
			var options := OptionButton.new()
			for item in String(entry.hint_string).split(","):
				options.add_item(humanize(String(item).split(":")[0].to_lower()))
			options.select(clampi(int(value), 0, options.item_count - 1))
			options.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			options.item_selected.connect(func(index: int) -> void: _apply(entry, index))
			line.add_child(options)
		TYPE_VECTOR3:
			_title(box, entry, title + "  (x, y, z in metres)")
			var spins: Array[SpinBox] = []
			for axis in 3:
				var spin := _spin({"min": -10.0, "max": 10.0, "step": 0.001, "suffix": "", "greater": true, "lesser": true})
				spin.value = (value as Vector3)[axis]
				spin.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				spins.append(spin)
				line.add_child(spin)
			for spin in spins:
				spin.value_changed.connect(func(_v: float) -> void: _apply(entry, Vector3(spins[0].value, spins[1].value, spins[2].value)))
			line.set_meta("spins", spins)
		_:
			_title(box, entry, title)
			var spin := _spin(limits)
			spin.value = float(value)
			spin.custom_minimum_size.x = 96
			if limits.ok:
				var slider := HSlider.new()
				slider.min_value = limits.min
				slider.max_value = limits.max
				slider.step = limits.step
				slider.value = float(value)
				slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				slider.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				slider.focus_mode = Control.FOCUS_NONE
				slider.value_changed.connect(func(v: float) -> void:
					spin.set_value_no_signal(v)
					_apply(entry, int(round(v)) if int(entry.type) == TYPE_INT else v))
				spin.value_changed.connect(func(v: float) -> void:
					slider.set_value_no_signal(v)
					_apply(entry, int(round(v)) if int(entry.type) == TYPE_INT else v))
				line.add_child(slider)
				line.set_meta("slider", slider)
			else:
				spin.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				spin.value_changed.connect(func(v: float) -> void: _apply(entry, int(round(v)) if int(entry.type) == TYPE_INT else v))
			line.add_child(spin)
			line.set_meta("spin", spin)
	line.add_child(reset)
	box.add_child(line)
	box.set_meta("line", line)
	box.set_meta("path", entry.path)
	_mark(entry)
	return box

func _title(box: VBoxContainer, entry: Dictionary, title: String) -> void:
	var label := WorkbenchUI.label(title, 14)
	label.set_meta("title", title)
	_titles[entry.path] = label
	box.add_child(label)

func _spin(limits: Dictionary) -> SpinBox:
	var spin := SpinBox.new()
	spin.min_value = limits.min
	spin.max_value = limits.max
	spin.step = limits.step
	spin.allow_greater = limits.greater
	spin.allow_lesser = limits.lesser
	spin.select_all_on_focus = true
	return spin

## The value the game uses for a setting (the Workbench compares against it).
func game_value(entry: Dictionary) -> Variant:
	var game: Resource = bench.rig.tuning_game.get(property())
	return value_at(game, String(entry.path)) if game != null else _kept.get(_picked, {}).get(entry.path)

func differs_from_game(entry: Dictionary) -> bool:
	return not TuningFiles.same(game_value(entry), entry.owner.get(entry.name))

## A changed setting says so: its title shows the game's value and turns amber, and its "game" button appears.
func _mark(entry: Dictionary) -> void:
	var changed := differs_from_game(entry)
	if _resets.has(entry.path) and is_instance_valid(_resets[entry.path]):
		_resets[entry.path].visible = changed
	if _titles.has(entry.path) and is_instance_valid(_titles[entry.path]):
		var label: Label = _titles[entry.path]
		label.text = String(label.get_meta("title")) + (("   (game: %s)" % _short(game_value(entry))) if changed else "")
		label.add_theme_color_override("font_color", WorkbenchUI.WARN if changed else WorkbenchUI.TEXT)

static func _short(value: Variant) -> String:
	if value is float:
		return "%.3f" % value
	if value is Vector3:
		return "(%.3f, %.3f, %.3f)" % [value.x, value.y, value.z]
	return str(value)

## Writes one value to the live profile (an experiment: nothing is saved). `refresh_row` puts the controls back in step.
func _apply(entry: Dictionary, value: Variant, refresh_row := false) -> void:
	if value == null:
		return
	entry.owner.set(entry.name, value)
	if property() == &"stair_profile":
		bench.rig.reapply_stair_profile()
	if refresh_row:
		_sync_row(entry)
	_mark(entry)
	_confirm = false
	_update_status()

func _sync_row(entry: Dictionary) -> void:
	for box in _rows.get_children():
		if not box.has_meta("path") or String(box.get_meta("path")) != String(entry.path):
			continue
		var line: HBoxContainer = box.get_meta("line")
		var value: Variant = entry.owner.get(entry.name)
		if line.has_meta("slider"):
			(line.get_meta("slider") as HSlider).set_value_no_signal(float(value))
		if line.has_meta("spin"):
			(line.get_meta("spin") as SpinBox).set_value_no_signal(float(value))
		if line.has_meta("spins"):
			var spins: Array = line.get_meta("spins")
			for axis in 3:
				(spins[axis] as SpinBox).set_value_no_signal((value as Vector3)[axis])
		for child in line.get_children():
			if child is CheckBox:
				(child as CheckBox).set_pressed_no_signal(bool(value))
			elif child is OptionButton:
				(child as OptionButton).select(int(value))

## Values changed since the draft was last kept (or since loading), on the profile shown.
func changed_count() -> int:
	var kept: Dictionary = _kept.get(_picked, {})
	var count := 0
	for entry in _entries:
		if not TuningFiles.same(kept.get(entry.path), entry.owner.get(entry.name)):
			count += 1
	return count

## The changes from the game on the profile shown: [{path, label, game, now}].
func game_changes() -> Array[Dictionary]:
	return TuningFiles.changes(bench.rig, property(), profile())

func _update_status(message := "") -> void:
	var changes := game_changes()
	var unkept := changed_count()
	if message != "":
		_status.text = message
	elif changes.is_empty():
		_status.text = "Same as the game. %d basic settings shown." % _basic_count()
	else:
		_status.text = "%d change%s from the game%s." % [changes.size(), "" if changes.size() == 1 else "s", (": %d not kept yet ('Keep as draft' keeps them after you close)" % unkept) if unkept > 0 else ", kept as a draft (the game does not use them)"]
	_status.add_theme_color_override("font_color", WorkbenchUI.WARN if not changes.is_empty() and message == "" else WorkbenchUI.ACCENT)
	var lines: Array[String] = []
	for change in changes.slice(0, 8):
		lines.append("  %s: %s -> %s" % [change.label, _short(change.game), _short(change.now)])
	if changes.size() > 8:
		lines.append("  ... and %d more" % (changes.size() - 8))
	_changes.text = "\n".join(lines)
	_apply_button.text = ("Confirm: write %d change%s to the game" % [changes.size(), "" if changes.size() == 1 else "s"]) if _confirm else "Apply to game..."
	_apply_button.disabled = changes.is_empty()

func _basic_count() -> int:
	var count := 0
	for entry in _entries:
		if is_basic(entry):
			count += 1
	return count

func _filter() -> void:
	var query := _search.text.strip_edges().to_lower() if is_instance_valid(_search) else ""
	var show_advanced := is_instance_valid(_advanced) and _advanced.button_pressed
	for box in _rows.get_children():
		if box.has_meta("text"):
			box.visible = String(box.get_meta("text")).contains(query) if query != "" else (show_advanced or bool(box.get_meta("basic")))
	# A group heading shows when any of its rows does.
	var heading: Control = null
	var any := false
	for node in _rows.get_children():
		if node.has_meta("group"):
			if heading != null:
				heading.visible = any
			heading = node
			any = false
		elif node.visible:
			any = true
	if heading != null:
		heading.visible = any

# ---- draft, game, Godot

## Keeps the profile shown as a draft (Workbench only). Returns the path, or "".
func save_draft() -> String:
	var path := TuningFiles.save_draft(bench.rig, property(), profile())
	if path == "":
		_update_status("Could not keep the draft (this character has no tuning folder).")
		return ""
	_kept[_picked] = _snapshot()
	_file_time[_picked] = FileAccess.get_modified_time(path)
	_update_status()
	return path

## First call shows what would change and asks for a second; the second (or `confirmed`) writes the profile where the game reads it. Returns the path written, or "".
func apply_to_game(confirmed := false) -> String:
	var changes := game_changes()
	if changes.is_empty():
		_update_status("Nothing to apply: this is what the game uses.")
		return ""
	if not _confirm and not confirmed:
		_confirm = true
		_update_status("These %d change%s will be written to %s. Press the button again to confirm." % [changes.size(), "" if changes.size() == 1 else "s", TuningFiles.game_path(bench.rig, property())])
		return ""
	_confirm = false
	var path := TuningFiles.apply_to_game(bench.rig, property(), profile())
	if path == "":
		_update_status("Could not write the game's settings.")
		return ""
	_kept[_picked] = _snapshot()
	_file_time.erase(_picked)
	_build()
	_update_status("Applied to the game: %s (commit it to share it; delete it to go back to the defaults)." % path)
	return path

## Throws the experiment and its draft away: every value goes back to what the game uses.
func discard() -> void:
	TuningFiles.discard(bench.rig, property(), profile())
	if property() == &"stair_profile":
		bench.rig.reapply_stair_profile()
	_kept[_picked] = _snapshot()
	_file_time.erase(_picked)
	_confirm = false
	_build()
	_update_status("Back to the game's values.")

## Keeps the draft (so it has a file), then asks the Godot editor to open it in its Inspector.
func edit_in_godot() -> void:
	var path := save_draft()
	if path == "":
		return
	_update_status(EditorBridge.send(EditorBridge.request(path)) + " Change values in the Inspector, then Ctrl+S: they show up here. The game is not changed until you press Apply to game.")

func _play_again() -> void:
	var id := StringName(String(bench.scenario_runner.scenario.get("id", "")))
	if id == &"" or not bench.start_scenario(id):
		_update_status("Play a scenario first (Start tab), then this replays it.")

func refresh() -> void:
	_replay.disabled = String(bench.scenario_runner.scenario.get("id", "")) == ""
	pick_up_outside_edits()

## Edits saved in the Godot editor reach the live character: a draft newer than the last read or keep is read again (unless there are changes here not kept yet, which it would overwrite), and a newer
## draft clips file is put into the player.
func pick_up_outside_edits() -> void:
	var path := TuningFiles.draft_path(bench.rig, property())
	if path != "" and FileAccess.file_exists(path):
		var time := FileAccess.get_modified_time(path)
		if not _file_time.has(_picked):
			_file_time[_picked] = time
		elif time != int(_file_time[_picked]):
			_file_time[_picked] = time
			if changed_count() > 0:
				_update_status("The draft changed in Godot, but you have changes here not kept yet: 'Keep as draft' keeps yours.")
			else:
				var count := reload_from_file(path)
				_update_status("Picked up %d value%s saved in Godot." % [count, "" if count == 1 else "s"])
	var clips_time := ClipFiles.modified_time(bench.rig)
	if clips_time != _clips_time:
		_clips_time = clips_time
		var result := ClipFiles.apply_saved(bench.rig)
		_fill_clips()
		_clip_status.text = "Picked up the clips saved in Godot: %s%s." % [", ".join(result.applied) if not result.applied.is_empty() else "none", (" (skipped, not a bone clip of this body: %s)" % ", ".join(result.skipped)) if not result.skipped.is_empty() else ""]

## Reads a profile file and copies every value into the live profile (so everything holding it sees the change). Returns how many values changed.
func reload_from_file(path: String) -> int:
	var disk := ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_IGNORE)
	if disk == null or profile() == null or disk.get_script() != profile().get_script():
		return 0
	var changed := 0
	for entry in _entries:
		var value: Variant = value_at(disk, String(entry.path))
		if value != null and not TuningFiles.same(value, entry.owner.get(entry.name)):
			entry.owner.set(entry.name, value)
			changed += 1
	if property() == &"stair_profile":
		bench.rig.reapply_stair_profile()
	_kept[_picked] = _snapshot()
	_build()
	return changed

# ---- clips

func _fill_clips() -> void:
	var keep := String(_clip_choice.get_item_metadata(_clip_choice.selected)) if _clip_choice.selected >= 0 else ""
	_clip_choice.clear()
	var current := String(bench.rig.animation_controller.current_state) if is_instance_valid(bench.rig.animation_controller) else ""
	var edited := ClipFiles.load_library(bench.rig)
	var pending := ClipFiles.changed_clips(bench.rig)
	for name in ClipFiles.clip_names(bench.rig):
		var note := "   (draft, not in the game yet)" if pending.has(name) else ("   (edited by hand)" if edited.has_animation(name) else "")
		_clip_choice.add_item(String(name) + note)
		_clip_choice.set_item_metadata(_clip_choice.item_count - 1, String(name))
		if String(name) == (keep if keep != "" else current):
			_clip_choice.select(_clip_choice.item_count - 1)
	_sync_clip_buttons()

func _sync_clip_buttons() -> void:
	var pending := ClipFiles.changed_clips(bench.rig).has(_picked_clip())
	_clip_apply.disabled = not pending
	_clip_apply.text = ("Confirm: the game plays your %s" % _picked_clip()) if _clip_confirm else "Apply this clip to the game"

func _picked_clip() -> StringName:
	return StringName(String(_clip_choice.get_item_metadata(_clip_choice.selected))) if _clip_choice.selected >= 0 else &""

## Picks a clip by name (tests).
func pick_clip(clip: StringName) -> void:
	for index in _clip_choice.item_count:
		if String(_clip_choice.get_item_metadata(index)) == String(clip):
			_clip_choice.select(index)
	_clip_confirm = false
	_sync_clip_buttons()

## Copies the chosen clip into the drafts (when needed) and opens it in the Godot editor on her body. `launch` false only queues the request (tests).
func edit_clip(launch := true) -> void:
	var clip := _picked_clip()
	var prepared := ClipFiles.prepare(bench.rig, clip)
	if not prepared.ok:
		_clip_status.text = prepared.message
		return
	_clips_time = ClipFiles.modified_time(bench.rig)
	_fill_clips()
	var sent := EditorBridge.send(EditorBridge.request(prepared.scene, ClipFiles.PLAYER, String(clip)), launch)
	_clip_status.text = "%s %s\nIn Godot: the Animation panel shows %s. Click Model > Skeleton3D, press 'Edit Mode' above the 3D view, rotate a bone, press the key icon next to it, then Ctrl+S. It plays here by itself." % [prepared.message, sent, clip]

## Two clicks: the first asks, the second (or `confirmed`) copies the draft clip to where the game reads it. Returns the path written, or "".
func apply_clip_to_game(confirmed := false) -> String:
	var clip := _picked_clip()
	if not ClipFiles.changed_clips(bench.rig).has(clip):
		_clip_status.text = "%s is the same in the drafts and the game: nothing to apply." % clip
		return ""
	if not _clip_confirm and not confirmed:
		_clip_confirm = true
		_sync_clip_buttons()
		_clip_status.text = "The game will play your version of %s (written to %s). Press the button again to confirm." % [clip, ClipFiles.game_path(bench.rig)]
		return ""
	_clip_confirm = false
	var path := ClipFiles.apply_clip(bench.rig, clip)
	_fill_clips()
	_clip_status.text = ("Applied: the game plays your %s (%s). Commit it to share it." % [clip, path]) if path != "" else "Could not write the game's clips."
	return path

## Throws the draft of the chosen clip away (back to the game's version).
func discard_clip() -> void:
	var clip := _picked_clip()
	if ClipFiles.discard_clip(bench.rig, clip):
		ClipFiles.apply_saved(bench.rig)
		_clips_time = ClipFiles.modified_time(bench.rig)
		_fill_clips()
		_clip_status.text = "%s: back to the game's version (a clip the game generates comes back after a reload)." % clip
	else:
		_clip_status.text = "%s has no draft." % clip

func _forget_clip() -> void:
	var clip := _picked_clip()
	if ClipFiles.forget(bench.rig, clip):
		_clips_time = ClipFiles.modified_time(bench.rig)
		_fill_clips()
		_clip_status.text = "%s is out of the drafts: the generated clip plays after a reload (Character tab > Apply and reload). Apply it to make the game do the same." % clip
	else:
		_clip_status.text = "%s is not an edited clip." % clip
