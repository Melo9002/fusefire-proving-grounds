/research/xcom-local/

# Local Project Ironclad output.
/artifacts/test-results/

# Generated local diagnostics and captures stay out of the game repository.
# Reviewed evidence belongs beside the current documentation when needed.
/artifacts/
/docs/**/*.png.import
