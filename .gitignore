# Godot 4+ specific ignores
.godot/
/android/
/build/

# Godot interrupted scene-save files
*.tscn*.tmp

# Local proprietary reference exports used for Operation XCOM research.
# Notes and original FuseFire experiments belong in Git; extracted assets do not.
/research/xcom-local/

# Local Project Ironclad output.
/artifacts/test-results/

# Local investigation/test products. Keep original review images and the tiny
# architecture oracle, not generated fixture libraries, logs or downloaded talks.
/artifacts/*
!/artifacts/*.png
!/artifacts/consultation-2026-10-20/
/artifacts/consultation-2026-10-20/*
!/artifacts/consultation-2026-10-20/captures/
/artifacts/consultation-2026-10-20/captures/*
!/artifacts/consultation-2026-10-20/captures/*.png
!/artifacts/spatial-transform-task-1.2/
/artifacts/spatial-transform-task-1.2/*
!/artifacts/spatial-transform-task-1.2/*.png
